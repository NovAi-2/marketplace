+
+class TotalPriceVisitorTest {
+    @Test
+    void totalPriceOfCatalog() {
+        // 1000 + 500 + 60 + 10 + 80
+        assertEquals(1650.0, new Marketplace(4).catalog.accept(new TotalPriceVisitor()), 1e-9);
+    }
+}
