+package marketplace;
+
+/** Total price of a subtree. Added later: no element class was changed. */
+public class TotalPriceVisitor implements Visitor<Double> {
+    @Override
+    public Double visitCatalog(Catalog c) { return c.categories().stream().mapToDouble(x -> x.accept(this)).sum(); }
+
+    @Override
+    public Double visitCategory(Category c) { return c.products().stream().mapToDouble(p -> p.accept(this)).sum(); }
+
+    @Override
+    public Double visitPhysical(PhysicalProduct p) { return p.price(); }
+
+    @Override
+    public Double visitDigital(DigitalProduct p) { return p.price(); }
+
+    @Override
+    public Double visitService(ServiceProduct p) { return p.price(); }
+
+    @Override
+    public Double visitSubscription(Subscription p) { return p.price(); }
+}
