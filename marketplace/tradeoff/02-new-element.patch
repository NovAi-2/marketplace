diff --git a/src/main/java/marketplace/GiftCard.java b/src/main/java/marketplace/GiftCard.java
new file mode 100644
index 0000000..3b3cc40
--- /dev/null
+++ b/src/main/java/marketplace/GiftCard.java
@@ -0,0 +1,12 @@
+package marketplace;
+
+public class GiftCard extends Product {
+    public GiftCard(String id, String name, double price) {
+        super(id, name, price);
+    }
+
+    @Override
+    public <R> R accept(Visitor<R> visitor) {
+        return visitor.visitGiftCard(this);
+    }
+}
